# The agent's environment (agent.syn, run from this folder): the same stack as client/.env,
# but ITS OWN keys — a secp256k1 key with a little ETH for fees (never the owner's), and a P-521
# pair for its events. The owner allowlists the agent's address with `allow-proposer`.
VELA_RPC_URL=http://localhost:8545
VELA_PROCESSOR=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
VELA_TEE_AUTHENTICATOR=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
VELA_AUTHORITY_URL=http://localhost:8081
VELA_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/hcce
VELA_APP_ID=
VELA_MAX_FEE=100
VELA_TOKEN=
# Anvil account #1 on the local kit; any funded key works.
VELA_SECP_KEY=59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
VELA_P521_KEY=
VELA_P521_PUB=
# Seconds between looks at inbox/ (a change in the folder wakes it sooner).
AGENT_INTERVAL=30
# Free-text invoices need an LLM: a provider and its key, e.g.
# SYNSEMA_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
